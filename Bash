# se placer sur la branche
git fetch origin
git checkout feature/ux-polish

# si package.json n'existe pas, le créer automatiquement
[ -f package.json ] || npm init -y

# générer uniquement package-lock.json (ne télécharge pas node_modules)
npm install --package-lock-only

# (optionnel) installer prettier/htmlhint localement sans modifier package.json
npm install --no-save prettier htmlhint

# vérifier et formater (optionnel)
npx prettier --check "**/*.{html,css,js,json,md}" || true
npx prettier --write "**/*.{html,css,js,json,md}"

# ajouter node_modules à .gitignore si nécessaire
grep -qxF "node_modules" .gitignore 2>/dev/null || echo "node_modules" >> .gitignore

# commit & push des changements (package-lock.json et fichiers formatés)
git add package-lock.json .gitignore
git add -A
git commit -m "chore: add package-lock and format files with Prettier"
git push origin feature/ux-polish
