diff --git a/format_repo.sh b/format_repo.sh new file mode 100755 index 0000000..e69de29 --- /dev/null +++ b/format_repo.sh @@ -0,0 +1,37 @@ +#!/usr/bin/env bash +set -euo pipefail + +echo "Switch to branch feature/ux-polish" +git fetch origin +git checkout feature/ux-polish + +# if no package.json, create a minimal one +if [ ! -f package.json ]; then

