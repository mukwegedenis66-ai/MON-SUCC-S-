"
{confirm,,}" == "yes" ]]; then

git add package-lock.json .gitignore
git add -A
git commit -m "chore: add package-lock and format files with Prettier"
git push origin feature/ux-polish
echo "Pushed. CI should re-run on the PR." +else
echo "Aborted commit/push. Review changes locally and commit when ready." +fi
+echo "Done."
