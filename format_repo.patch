+# install Prettier and HTMLHint locally (no-save keeps package.json unchanged) +echo "Installing Prettier and HTMLHint (local, no-save)" +npm install --no-save prettier htmlhint + +# generate package-lock.json only +echo "Generating package-lock.json" +npm install --package-lock-only + +# preview which files need formatting (no fail) +echo "Preview: running prettier --check (no fail)" +npx prettier --check "/*.{html,css,js,json,md}" || true + +# run Prettier to write fixes +echo "Running prettier --write to format files" +npx prettier --write "/.{html,css,js,json,md}" + +# run HTMLHint to show warnings (does not fail the script) +echo "Running htmlhint for HTML warnings" +npx htmlhint "**/.html" || true + +# ensure node_modules is ignored +if ! grep -qxF "node_modules" .gitignore 2>/dev/null; then

